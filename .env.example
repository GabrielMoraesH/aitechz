# Application runtime connection (use the pooled connection in production).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Direct connection used only by Prisma CLI and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Product images use local storage by default in development. Set to
# "cloudinary" in production; no silent filesystem fallback is performed.
PRODUCT_IMAGE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
